# ==============================================================================
# ABYSSEYE ENVIRONMENT CONFIGURATION
# SIH 2026 Problem 26057: Autonomous Underwater Marine Debris Detection
# ==============================================================================

# Core Application
ENVIRONMENT=production
PROJECT_NAME="ABYSSEYE Automated Sonar Debris Detection"
LOG_LEVEL=INFO
SECRET_KEY=abysseye-sih26057-in-production-secure-token-2026

# Server & Network
HOST=0.0.0.0
PORT=8000
WORKERS=4
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:80"]

# Pipeline & ML Engine
MODEL_PATH=models/lightgbm_fusion_latest.joblib
CALIBRATION_METHOD=isotonic
CONFIDENCE_THRESHOLD=0.75
MAX_CONTACTS_PER_PING=20
REALTIME_WATERFALL_WIDTH=768
REALTIME_WATERFALL_HEIGHT=384

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/survey-stream
